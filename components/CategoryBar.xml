<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryBar" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/CategoryBar.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/ChannelManager.brs" />

  <interface>
    <field id="selectedIndex" type="integer" value="0" alwaysNotify="true" />
    <!-- Parent sets true when UP focuses bar; false when DOWN returns to player -->
    <field id="showFocus" type="boolean" value="false" alwaysNotify="true" />
    <field id="categoryConfirmed" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle
      id="barBg"
      width="1920"
      height="80"
      color="0x0B1526FF"
      translation="[0,0]" />

    <LayoutGroup
      id="tabGroup"
      layoutDirection="horiz"
      itemSpacings="[0]"
      translation="[0,0]" />
  </children>
</component>

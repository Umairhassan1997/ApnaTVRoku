<?xml version="1.0" encoding="utf-8" ?>
<component name="LivePlayerScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/LivePlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/ChannelManager.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/UsageTimerManager.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/SubscriptionManager.brs" />

  <interface>
    <field id="timeExpired" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="0x000000" />

    <!-- Category bar sits at top; video fills the rest -->
    <CategoryBar id="categoryBar" translation="[0,0]" />

    <!--
      Video starts below the 80-px category bar.
      height = 1080 - 80 = 1000
    -->
    <Video
      id="liveVideo"
      width="1920"
      height="1000"
      translation="[0,80]"
      enableUI="false"
      enableTrickPlay="false">

      <BusySpinner id="bufferingSpinner" translation="[900,450]" visible="false" />

      <!-- Channel name overlay (bottom-left of video) -->
      <Group id="channelOverlay" translation="[60,820]" visible="false">
        <Rectangle width="560" height="120" color="0x000000" opacity="0.75" />
        <Label
          id="channelNumberLabel"
          translation="[20,10]"
          width="520" height="40"
          color="0xCCCCCCFF"
          horizAlign="left" vertAlign="center">
          <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="26" />
        </Label>
        <Label
          id="channelNameLabel"
          translation="[20,54]"
          width="520" height="56"
          color="0xFFFFFFFF"
          wrap="true" maxLines="1"
          horizAlign="left" vertAlign="top">
          <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="36" />
        </Label>
      </Group>

      <Label
        id="errorLabel"
        translation="[260,440]"
        width="1400" height="120"
        visible="false"
        color="0xFFFFFFFF"
        wrap="true" maxLines="3"
        horizAlign="center" vertAlign="center"
        text="Unable to play channel.&#xA;Press Left or Right to try another channel.">
        <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="36" />
      </Label>
    </Video>

    <Timer id="overlayHideTimer" duration="2.5" repeat="false" />
    <Timer id="usageTickTimer"   duration="1"   repeat="true" />
  </children>
</component>
